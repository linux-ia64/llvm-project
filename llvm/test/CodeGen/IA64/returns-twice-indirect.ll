; CHECK-NEXT:    add r22 = 56, r12
; CHECK-NEXT:    ;;
; CHECK-NEXT:    st8 [r22] = r4
; CHECK-NEXT:    add r22 = 48, r12
; CHECK-NEXT:    ;;
