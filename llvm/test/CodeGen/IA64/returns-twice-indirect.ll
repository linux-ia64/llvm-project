; CHECK-NEXT:    add r22 = 40, r12
; CHECK-NEXT:    ;;
; CHECK-NEXT:    st8 [r22] = r7
; CHECK-NEXT:    add r22 = 32, r12
; CHECK-NEXT:    ;;
