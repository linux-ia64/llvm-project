; RUN: llc -mtriple=ia64 < %s | FileCheck %s

; Basic integer arithmetic and bitwise/shift operations on i32 and i64.

target datalayout = "e-m:e-p:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "ia64"

define i64 @add_i64(i64 %a, i64 %b) {
; CHECK-LABEL: add_i64#
; CHECK:       // %bb.0:
; CHECK-NEXT:    alloc r3 = ar.pfs,0,2,0,0
; CHECK-NEXT:    // PSEUDO_ALLOC
; CHECK-NEXT:    add r8 = r32, r33
; CHECK-NEXT:    ;;
; CHECK-NEXT:    mov ar.pfs = r3
; CHECK-NEXT:    ;;
; CHECK-NEXT:    br.ret.sptk.many rp
  %r = add i64 %a, %b
  ret i64 %r
}

